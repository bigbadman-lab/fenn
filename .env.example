# FENN environment variable names
# Copy to .env.local and fill in values. Never commit real secrets.
#
# Local ops (`npm run x:poll`, `agent:run-x`, …) load `.env.local` when present
# via scripts/load-env.ts. Render / CI inject the same names into process.env —
# no .env.local file required in production.

# --- Required (Stage 1 foundation + Stage 3 identity) ---
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_PRIVY_APP_ID=

# Server-only secrets (never NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=
PRIVY_APP_SECRET=

# Stage 6 admin allowlist — comma-separated EVM addresses (never NEXT_PUBLIC_*)
# Example: FENN_ADMIN_WALLETS=0xabc...,0xdef...
FENN_ADMIN_WALLETS=

# Living Greenwood 5 — Desk allowlist — comma-separated EVM addresses (never NEXT_PUBLIC_*)
# Comma-separated EVM wallets authorised to access `/desk`.
# Empty/missing = no Desk access. Independent of FENN_ADMIN_WALLETS.
# Example: FENN_DESK_WALLETS=0xabc...,0xdef...
FENN_DESK_WALLETS=

# Greenwood access override — comma-separated EVM addresses (never NEXT_PUBLIC_*)
# Trusted test/founder wallets may CROSS without meeting the LEAF threshold.
# Does NOT award LEAF, mutate balances, or invent recognition. Server-only.
# Example: GREENWOOD_ACCESS_WALLETS=0xabc...,0xdef...
GREENWOOD_ACCESS_WALLETS=

# --- Recognised; unused until later stages ---
# Camp AI (Stage 7+) — server-only. Site builds without it; Camp turns fail closed.
# Never use NEXT_PUBLIC_OPENAI_API_KEY.
OPENAI_API_KEY=

# Stage 9 Treasury — server-only Robinhood Chain RPC (never NEXT_PUBLIC_*).
# Chain ID is a fixed protocol constant (4663) in src/lib/treasury/chain-definition.ts.
#
# Live /commons balances require ALL of:
#   1. ROBINHOOD_CHAIN_RPC_URL (this env)
#   2. treasury_config.treasury_wallet_address (DB singleton — product authority)
#   3. tracked treasury_assets rows with chain_id = 4663
# See supabase/examples/stage9_treasury_ops_example.sql (example only, not a migration).
#
# Canonical Treasury wallet lives in treasury_config (DB). FENN_TREASURY_ADDRESS is
# bootstrap/ops aid only and must not override a populated DB wallet.
ROBINHOOD_CHAIN_RPC_URL=
FENN_TREASURY_ADDRESS=

# Stage 12.2 X perception (read mentions) — server-only.
# Required for npm run x:poll / x:verify-account:
X_BEARER_TOKEN=
# After npm run x:verify-account, pin the resolved @askfenn user id (digit string):
FENN_X_USER_ID=
# Optional; defaults to askfenn
FENN_X_USERNAME=

# Stage 12.6 write-as-@askfenn (OAuth 2.0 + PKCE) — server-only.
# Required for agent:execute-x reply effects + admin OAuth bind:
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
# Optional legacy app keys (not used for OAuth 2.0 user-context posting):
X_API_KEY=
X_API_SECRET=
# OAuth callback is always {NEXT_PUBLIC_SITE_URL}/api/auth/x/callback
# Production allowlist must include: https://imfenn.com/api/auth/x/callback
# OAuth start paths (same PKCE + callback; separate allowlists):
# Desk (primary): POST /api/desk/agent/oauth/start  — requires FENN_DESK_WALLETS
# Admin (compat): GET  /api/admin/x/oauth/start     — requires FENN_ADMIN_WALLETS
# Callback remains {NEXT_PUBLIC_SITE_URL}/api/auth/x/callback for both.
# Tokens are stored in DB (x_oauth_credentials), never in env after bind.

# Stage 13.1 / Render X agent production gate (Render Cron only).
# Website + OAuth callbacks stay on Vercel. See docs/render-agent.md.
# disabled | dry_run | live — missing/invalid defaults to disabled (never live).
FENN_X_AGENT_EXECUTION_MODE=disabled
# Conservative cron bounds:
FENN_X_AGENT_BATCH_SIZE=1
FENN_X_AGENT_MAX_RUNTIME_SECONDS=50
# Optional Postgres lease key (default x_agent):
# FENN_X_AGENT_LEASE_KEY=x_agent

# Living Book daily cron — server-only. Required for /api/cron/chronicle-daily.
# Vercel Cron sends Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# --- The Clearing (community conversation) ---
# Required production secret (min 32 chars). HMAC for Traveller HttpOnly cookies.
# Never NEXT_PUBLIC_*. Never reuse as service role / admin secret.
# Production fails closed if missing. Dev may fall back to SUPABASE_SERVICE_ROLE_KEY.
# Rotation invalidates existing Traveller cookies (new mint → new temporary name).
FENN_CLEARING_COOKIE_SECRET=
